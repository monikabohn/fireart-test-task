<nav class="mb-8 text-sm text-gray-500">
    <% breadcrumb.forEach((item, index) => { %>

        <% if (item.href) { %>
            <a href="<%= item.href %>" class="hover:text-gray-900">
                <%= item.label %>
            </a>

        <% } else { %>
            <span class="text-gray-900">
                <%= item.label %>
            </span>
        <% } %>

        <% if (index < breadcrumb.length - 1) { %>
            <span class="mx-2"> / </span>
        <% } %>

    <% }) %>
</nav>