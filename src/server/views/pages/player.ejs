<div class="bg-white rounded-xl shadow p-6 my-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-8 border-b border-gray-200 pb-3">
        <%= player.strPlayer %>
    </h1>
    <div class="grid md:grid-cols-3 gap-8">
        <div>
            <% if (player.strThumb) { %>
                <img src="<%= player.strThumb ||  '/images/player-placeholder.svg' %>"
                     alt="<%= player.strPlayer %>"
                     class="w-full rounded-xl object-cover"
                />
            <% } %>

            <div class="mt-6 my-8">
                <h2 class="text-xl font-semibold mb-4">
                    Player Details
                </h2>

                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Position</span>
                        <span class="text-gray-900">
                            <%= player.strPosition || 'Unknown' %>
                        </span>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-gray-500">Nationality</span>
                        <span class="text-gray-900">
                            <%= player.strNationality || 'Unknown' %>
                        </span>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-gray-500">Born</span>
                        <span class="text-gray-900">
                            <%= player.dateBorn || 'N/A' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="md:col-span-2 border-t md:border-t-0 md:border-l border-gray-200 pt-6 md:pt-0 md:pl-6">
            <h2 class="text-xl font-semibold mb-4">
                Biography
            </h2>
            <p class="text-gray-700 leading-7 whitespace-pre-line">
                <%= player.strDescriptionEN || 'No biography available.' %>
            </p>
        </div>
    </div>
</div>

<a href="/teams/<%= player.idTeam %>"
   class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 my-6"
>
    ← Back to team
</a>


