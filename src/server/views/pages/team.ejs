<div class="bg-white rounded-xl shadow p-6 my-6">
  <h1 class="text-2xl font-bold mb-6 border-b border-gray-200 pb-3">
    <%= team.strTeam %>
  </h1>

  <div class="grid lg:grid-cols-3 gap-8">
    <div class="space-y-3 text-gray-700">
      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Sport</span>
          <span class="text-gray-900"><%= team.strSport || 'Unknown' %></span>
        </div>

        <div class="flex justify-between">
          <span class="text-gray-500">League</span>
          <span class="text-gray-900"><%= team.strLeague || 'Unknown' %></span>
        </div>

        <div class="flex justify-between">
          <span class="text-gray-500">Country</span>
          <span class="text-gray-900"><%= team.strCountry || 'Unknown'  %></span>
        </div>

        <div class="flex justify-between">
          <span class="text-gray-500">Founded</span>
          <span class="text-gray-900"><%= team.intFormedYear || 'Unknown' %></span>
        </div>

      </div>
    </div>

    <div class="lg:col-span-2 border-t lg:border-t-0 lg:border-l border-gray-200 pt-6 lg:pt-0 lg:pl-6">
      <h2 class="text-xl font-semibold mb-4">
        About
      </h2>
      <p class="text-gray-700 leading-7">
        <%= team.strDescriptionEN || 'No description available' %>
      </p>
    </div>
  </div>
</div>

<div id="players-app" data-team-id="<%= team.idTeam %>"></div>

<a href="/teams"
   class="inline-flex items-center gap-4 text-sm font-medium text-gray-600 hover:text-gray-900 my-6"
>
  ← Back to teams
</a>

