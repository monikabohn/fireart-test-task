<div class="bg-white rounded-xl shadow p-6 my-8">
    <h1 class="text-2xl font-bold mb-6 border-b border-gray-200 pb-3"><%= title %></h1>
    <div class="text-gray-600 leading-7"><%= description %></div>
</div>

<h2 class="text-xl font-bold text-gray-900 mb-6 border-b border-gray-200 pb-3 pt-8">Teams</h2>

<ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  <% teams.forEach(team => { %>
    <li>
      <a href="/teams/<%= team.idTeam %>"
         class="bg-white rounded-xl shadow hover:shadow-lg transition p-4 flex flex-col items-center">
          <img src="<%= team.strBadge %>"
               class="w-20 h-20 object-contain mb-3"
          />
          <h3 class="font-semibold text-sm text-center">
              <%= team.strTeam %>
          </h3>
      </a>
    </li>
  <% }) %>
</ul>